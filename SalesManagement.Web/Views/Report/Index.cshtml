@model ReportViewModel
@{ ViewData["Title"] = "Báo cáo"; }
<section>
    <div class="module-heading"><div><span class="eyebrow">Cửa hàng hiện tại</span><h1>Báo cáo cơ bản</h1><p>Lọc theo ngày tạo đơn. Số tiền được nhân viên ghi nhận thủ công.</p></div></div>
    <form method="get" class="content-card mb-4"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3 align-items-end"><div class="col-md-4"><label class="form-label" for="from">Từ ngày</label><input class="form-control" id="from" name="from" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" /></div><div class="col-md-4"><label class="form-label" for="to">Đến ngày</label><input class="form-control" id="to" name="to" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" /></div><div class="col-md-4"><button class="btn btn-primary" type="submit">Xem báo cáo</button></div></div></form>
    <div class="row g-3 mb-4"><div class="col-md-6"><div class="content-card"><span class="eyebrow">Đơn hoàn tất</span><h2>@Model.CompletedSales.ToString("N0") ₫</h2></div></div><div class="col-md-6"><div class="content-card"><span class="eyebrow">Tiền đã ghi nhận, chưa hoàn</span><h2>@Model.RecordedPayments.ToString("N0") ₫</h2></div></div></div>
    <div class="content-card mb-4"><h2>Số đơn theo trạng thái</h2><div class="row"><div class="col-md-4">Đang xử lý: <strong>@Model.ConfirmedCount</strong></div><div class="col-md-4">Hoàn thành: <strong>@Model.CompletedCount</strong></div><div class="col-md-4">Đã hủy: <strong>@Model.CancelledCount</strong></div></div></div>
    <div class="content-card"><h2>Sản phẩm bán chạy</h2>@if (Model.TopProducts.Count == 0) { <p class="text-muted">Chưa có sản phẩm bán trong khoảng ngày này.</p> } else { <div class="table-responsive"><table class="table"><thead><tr><th>Sản phẩm</th><th>Số lượng</th><th>Doanh số dòng hàng</th></tr></thead><tbody>@foreach (var item in Model.TopProducts) { <tr><td>@item.Name</td><td>@item.Quantity</td><td>@item.Sales.ToString("N0") ₫</td></tr> }</tbody></table></div> }</div>
</section>
