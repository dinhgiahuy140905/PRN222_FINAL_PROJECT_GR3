@model IReadOnlyList<Product>
@{
    ViewData["Title"] = "Sản phẩm";
    var search = ViewData["Search"] as string;
    var lowStockOnly = ViewData["LowStockOnly"] as bool? == true;
}

<section>
    <div class="module-heading">
        <div><span class="eyebrow">Kho hàng</span><h1>Sản phẩm</h1><p>Quản lý danh mục, giá bán và tồn kho của cửa hàng hiện tại.</p></div>
        <div class="module-actions"><a class="btn btn-light-primary" asp-controller="Category" asp-action="Index">Danh mục</a><a class="btn btn-primary action-button" asp-action="Create"><span>＋</span> Thêm sản phẩm</a></div>
    </div>

    @if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

    <div class="content-card">
        <form class="product-toolbar" method="get">
            <div class="search-field"><span>⌕</span><input class="form-control" type="search" name="search" value="@search" placeholder="Tìm theo tên, SKU hoặc mã vạch" /></div>
            <label class="form-check low-stock-filter"><input class="form-check-input" type="checkbox" name="lowStockOnly" value="true" checked="@lowStockOnly" onchange="this.form.submit()" /><span class="form-check-label">Chỉ sản phẩm sắp hết</span></label>
            <button class="btn btn-light-primary" type="submit">Tìm kiếm</button>
        </form>

        @if (Model.Count == 0)
        {
            <div class="module-empty"><span>▤</span><h2>Chưa có sản phẩm phù hợp</h2><p>Thêm sản phẩm mới hoặc thay đổi điều kiện tìm kiếm.</p><a class="btn btn-primary" asp-action="Create">Thêm sản phẩm</a></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table product-table">
                    <thead><tr><th>Sản phẩm</th><th>Danh mục</th><th>Giá bán</th><th>Tồn kho</th><th>Trạng thái</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var product in Model)
                        {
                            var isLowStock = product.Inventory.Quantity <= product.Inventory.ReorderLevel;
                            <tr>
                                <td><div class="product-name-cell"><span class="product-thumb">▤</span><span><strong>@product.Name</strong><small>SKU: @product.Sku · @product.Unit</small></span></div></td>
                                <td>@(product.Category?.Name ?? "Chưa phân loại")</td>
                                <td class="fw-semibold">@product.SalePrice.ToString("N0") ₫</td>
                                <td><strong class="@(isLowStock ? "text-danger" : null)">@product.Inventory.Quantity</strong><small class="d-block text-muted">Cảnh báo: @product.Inventory.ReorderLevel</small></td>
                                <td>@if (isLowStock) { <span class="badge-soft badge-warning">Sắp hết</span> } else { <span class="badge-soft badge-success">Còn hàng</span> }</td>
                                <td><div class="table-actions"><a asp-action="AdjustStock" asp-route-id="@product.Id">Điều chỉnh kho</a><a asp-action="Edit" asp-route-id="@product.Id">Sửa</a><form asp-action="Deactivate" asp-route-id="@product.Id" method="post" onsubmit="return confirm(''Ngừng kinh doanh sản phẩm này?'')"><button type="submit">Ngừng bán</button></form></div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
