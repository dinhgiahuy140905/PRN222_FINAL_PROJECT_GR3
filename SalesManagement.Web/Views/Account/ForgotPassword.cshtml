@model ForgotPasswordViewModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Quên mật khẩu"; }
<div class="row justify-content-center"><div class="col-md-6 col-lg-5"><div class="content-card">
    <h1 class="h3">Quên mật khẩu</h1>
    @if (ViewData["Sent"] is true)
    {
        <div class="alert alert-success" role="status">Nếu email đã được đăng ký, hướng dẫn đặt lại mật khẩu sẽ được gửi đến email đó.</div>
    }
    else
    {
        <p>Nhập email đăng ký để nhận liên kết đặt lại mật khẩu có hiệu lực 30 phút.</p>
        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control mb-3" autocomplete="email" />
            <button class="btn btn-primary w-100" type="submit">Gửi hướng dẫn</button>
        </form>
    }
    <a asp-action="Login" class="d-block mt-3">Quay lại đăng nhập</a>
</div></div></div>
