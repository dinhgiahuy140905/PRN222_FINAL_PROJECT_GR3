@model RegisterViewModel
@{ ViewData["Title"] = "Đăng ký"; }
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="content-card">
            <div class="text-center mb-4">
                <span class="brand-mark d-inline-grid mb-3">S</span>
                <h1 class="h3 fw-bold">Tạo tài khoản mới</h1>
                <p class="text-muted mb-0">Thiết lập tài khoản chủ sở hữu và cửa hàng đầu tiên</p>
            </div>
            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" autocomplete="name" placeholder="Nguyễn Văn A" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" placeholder="you@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="StoreName" class="form-label fw-semibold"></label>
                    <input asp-for="StoreName" class="form-control" autocomplete="organization" placeholder="Ví dụ: Cửa hàng Minh Anh" />
                    <span asp-validation-for="StoreName" class="text-danger small"></span>
                    <div class="form-text">Bạn sẽ được gán quyền chủ sở hữu của cửa hàng này.</div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" placeholder="Tối thiểu 6 ký tự" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Nhập lại mật khẩu" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary w-100 py-2 mt-2">Tạo tài khoản và cửa hàng</button>
            </form>
            <p class="text-center text-muted small mt-4 mb-0">Đã có tài khoản? <a asp-action="Login" class="text-primary fw-semibold">Đăng nhập</a></p>
        </div>
    </div>
</div>
