@model LoginViewModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Đăng nhập"; }

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="content-card">
            <div class="text-center mb-4">
                <img class="auth-card-logo mb-3" src="~/images/saleshub-mark.svg" alt="SalesHub" />
                <h1 class="h3 fw-bold">Chào mừng trở lại</h1>
                <p class="text-muted mb-0">Đăng nhập để tiếp tục quản lý cửa hàng</p>
            </div>
            @if (TempData["PasswordResetSuccess"] is string resetMessage)
            {
                <div class="alert alert-success">@resetMessage</div>
            }
            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <a asp-action="ForgotPassword" class="small text-primary">Quên mật khẩu?</a>
                    </div>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label small"></label>
                </div>
                <button type="submit" class="btn btn-primary w-100 py-2">Đăng nhập</button>
            </form>
            <p class="text-center text-muted small mt-4 mb-0">Chưa có tài khoản? <a asp-action="Register" class="text-primary fw-semibold">Đăng ký ngay</a></p>
        </div>
    </div>
</div>
