@model StoreNotificationsViewModel
<div class="dropdown store-notifications">
    <button class="icon-button" id="notificationToggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Thông báo cửa hàng">
        <svg viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg>
        @if (Model.TotalCount > 0) { <span class="notification-count">@(Model.TotalCount > 99 ? "99+" : Model.TotalCount.ToString())</span> }
    </button>
    <div class="dropdown-menu dropdown-menu-end notification-menu" aria-labelledby="notificationToggle">
        <h2 class="notification-heading">Thông báo cửa hàng</h2>
        <p class="notification-description">Tình trạng hiện tại, cập nhật khi tải lại trang.</p>
        @if (!Model.HasStore)
        {
            <a class="dropdown-item" asp-controller="Store" asp-action="Select">Chọn cửa hàng để xem thông báo</a>
        }
        else if (Model.Items.Count == 0)
        {
            <p class="notification-empty">Không có cảnh báo hoặc đơn cần xử lý.</p>
        }
        else
        {
            @foreach (var item in Model.Items)
            {
                <a class="dropdown-item notification-item" asp-controller="@item.Controller" asp-action="@item.Action" asp-route-status="@item.Status" asp-route-paymentStatus="@item.PaymentStatus">
                    <span>@item.Text</span><strong>@item.Count</strong>
                </a>
            }
        }
    </div>
</div>
