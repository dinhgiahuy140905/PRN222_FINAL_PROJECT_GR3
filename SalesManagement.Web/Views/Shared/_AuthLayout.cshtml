<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f7fb" />
    <title>@ViewData["Title"] - SalesHub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <header class="auth-header">
        <a class="auth-brand" asp-controller="Home" asp-action="Index"><span>S</span><b>Sales<i>Hub</i></b></a>
        <a class="auth-back" asp-controller="Home" asp-action="Index">← Về trang chủ</a>
    </header>
    <main class="auth-main">@RenderBody()</main>
    <footer class="auth-footer">© @DateTime.Now.Year SalesHub · Quản lý cửa hàng trong một nơi</footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
