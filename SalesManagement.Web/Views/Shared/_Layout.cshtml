@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#211957" />
    <title>@ViewData["Title"] - SalesHub</title>
    <link rel="icon" type="image/svg+xml" href="~/images/saleshub-mark.svg" />
    <script>
        (() => {
            const root = document.documentElement;
            const preference = localStorage.getItem("saleshub-theme");
            const theme = preference === "light" || preference === "dark" ? preference :
                (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
            root.dataset.theme = theme;
            root.dataset.themePreference = preference || "system";
            root.dataset.sidebar = localStorage.getItem("saleshub-sidebar-collapsed") === "true"
                ? "collapsed"
                : "expanded";
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar" id="appSidebar">
            <div class="sidebar-header">
                <a class="brand" id="sidebarBrand" data-tooltip="Mở menu" asp-controller="Home" asp-action="Dashboard" aria-label="SalesHub - Dashboard"><img class="brand-mark" src="~/images/saleshub-mark.svg" alt="" /><span>Sales<span>Hub</span></span></a>
                <button class="sidebar-collapse" id="sidebarCollapse" type="button" aria-label="Thu gọn sidebar" title="Thu gọn sidebar">
                    <svg viewBox="0 0 24 24"><path d="m15 18-6-6 6-6" /></svg>
                </button>
            </div>

            <div class="sidebar-group">
                <div class="sidebar-label">Tổng quan</div>
                <nav aria-label="Điều hướng chính">
                    <a class="nav-link @(currentController == "Home" && currentAction == "Dashboard" ? "active" : null)" data-tooltip="Dashboard" asp-controller="Home" asp-action="Dashboard">
                        <span class="nav-icon"><svg viewBox="0 0 24 24"><path d="M3 11 12 3l9 8" /><path d="M5 10v10h14V10M9 20v-6h6v6" /></svg></span><span class="nav-text">Dashboard</span>
                    </a>
                    <a class="nav-link @(currentController == "Order" ? "active" : null)" data-tooltip="Đơn hàng" asp-controller="Order" asp-action="Index">
                        <span class="nav-icon"><svg viewBox="0 0 24 24"><path d="M6 7h12l1 13H5L6 7Z" /><path d="M9 9V6a3 3 0 0 1 6 0v3" /></svg></span><span class="nav-text">Đơn hàng</span>
                    </a>
                    <a class="nav-link @(currentController == "Product" || currentController == "Category" ? "active" : null)" data-tooltip="Sản phẩm" asp-controller="Product" asp-action="Index">
                        <span class="nav-icon"><svg viewBox="0 0 24 24"><path d="m4 7 8-4 8 4-8 4-8-4Z" /><path d="m4 7v10l8 4 8-4V7M12 11v10" /></svg></span><span class="nav-text">Sản phẩm</span>
                    </a>
                    <a class="nav-link" data-tooltip="Khách hàng" href="#">
                        <span class="nav-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg></span><span class="nav-text">Khách hàng</span>
                    </a>
                </nav>
            </div>

            <div class="sidebar-group management-group">
                <div class="sidebar-label">Quản lý</div>
                <nav aria-label="Điều hướng quản lý">
                    <a class="nav-link @(currentController == "Store" ? "active" : null)" data-tooltip="Cửa hàng" asp-controller="Store" asp-action="Select">
                        <span class="nav-icon"><svg viewBox="0 0 24 24"><path d="M3 9h18l-2-5H5L3 9Z" /><path d="M5 9v11h14V9M9 20v-6h6v6" /><path d="M3 9a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0" /></svg></span><span class="nav-text">Cửa hàng</span>
                    </a>
                    <a class="nav-link @(currentController == "Settings" ? "active" : null)" data-tooltip="Cài đặt" asp-controller="Settings" asp-action="Index">
                        <span class="nav-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.83 2.83-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21h-4v-.09A1.7 1.7 0 0 0 8.6 19.4a1.7 1.7 0 0 0-1.88.34l-.06.06-2.83-2.83.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1 1.7 1.7 0 0 0-1.1-.4H3v-4h.09A1.7 1.7 0 0 0 4.6 8.6a1.7 1.7 0 0 0-.34-1.88l-.06-.06 2.83-2.83.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6 1.7 1.7 0 0 0 .4-1.1V3h4v.09A1.7 1.7 0 0 0 15.4 4.6a1.7 1.7 0 0 0 1.88-.34l.06-.06 2.83 2.83-.06.06A1.7 1.7 0 0 0 19.4 9c.36.25.57.65.6 1.09V10h1v4h-.09c-.44.03-.84.24-1.09.6-.2.12-.34.26-.42.4Z" /></svg></span><span class="nav-text">Cài đặt</span>
                    </a>
                </nav>
            </div>

            <a class="sidebar-help" href="#">
                <span class="help-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M9.8 9a2.4 2.4 0 1 1 3.2 2.26c-.63.28-1 .75-1 1.49V13M12 17h.01" /></svg></span>
                <span class="help-copy"><strong>Cần hỗ trợ?</strong><small>Liên hệ đội ngũ SalesHub</small></span>
                <svg class="help-arrow" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6" /></svg>
            </a>
        </aside>
        <button class="sidebar-backdrop" id="sidebarBackdrop" type="button" aria-label="Đóng menu"></button>

        <div class="main-content">
            <header class="topbar">
                <div class="topbar-start"><button class="menu-toggle" id="menuToggle" type="button" aria-controls="appSidebar" aria-expanded="false" aria-label="Mở menu"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16" /></svg></button><div><strong>@ViewData["Title"]</strong><span>@DateTime.Now.ToString("dd/MM/yyyy")</span></div></div>
                <div class="topbar-actions">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var storeName = User.FindFirst(SalesManagement.Web.Services.StoreClaimTypes.StoreName)?.Value;
                        <a class="store-switcher" asp-controller="Store" asp-action="Select" title="Chuyển cửa hàng"><span>▦</span><span><small>Cửa hàng hiện tại</small><strong>@(storeName ?? "Chưa chọn cửa hàng")</strong></span><b>⌄</b></a>
                    }
                    <button class="icon-button theme-toggle" id="themeToggle" type="button" aria-label="Chuyển giao diện" data-tooltip="Chế độ tối">
                        <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24"><path d="M20 15.2A8.5 8.5 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z" /></svg>
                        <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                    </button>
                    <button class="icon-button" type="button" aria-label="Thông báo"><svg viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg><i></i></button>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var avatarPath = User.FindFirst(SalesManagement.Web.Services.StoreClaimTypes.AvatarPath)?.Value;
                        <div class="user-info">
                            <span class="avatar">
                                @if (!string.IsNullOrWhiteSpace(avatarPath)) { <img src="@avatarPath" alt="" /> }
                                else { @User.Identity.Name?.Substring(0, 1).ToUpper() }
                            </span>
                            <span><strong>@User.Identity.Name</strong><small>@(User.FindFirst(SalesManagement.Web.Services.StoreClaimTypes.StoreRole)?.Value == "Owner" ? "Chủ sở hữu" : "Nhân viên")</small></span>
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post"><button class="logout-button" type="submit">Đăng xuất</button></form>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-light-primary" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                    }
                </div>
            </header>
            <main class="page-content">@RenderBody()</main>
            <footer class="footer">© @DateTime.Now.Year SalesHub · Nền tảng quản lý bán hàng đa cửa hàng</footer>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/preferences.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
