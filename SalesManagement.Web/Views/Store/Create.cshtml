@model CreateStoreViewModel
@{
    ViewData["Title"] = "Tạo cửa hàng";
    var firstStore = ViewData["FirstStore"] as bool? == true;
}

<section class="store-form-wrap">
    <div class="content-card store-form-card">
        <span class="eyebrow">@(firstStore ? "Bước cuối cùng" : "Thiết lập cửa hàng")</span>
        <h1>@(firstStore ? "Tạo cửa hàng đầu tiên" : "Tạo cửa hàng mới")</h1>
        <p class="text-muted">Bạn sẽ là Owner của cửa hàng này và có thể thêm nhân viên sau khi hoàn tất.</p>
        <form asp-action="Create" method="post">
            <input type="hidden" name="firstStore" value="@firstStore.ToString().ToLowerInvariant()" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold"></label>
                <input asp-for="Name" class="form-control" placeholder="Ví dụ: Cửa hàng Minh Anh" autofocus />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Address" class="form-label fw-semibold"></label>
                <input asp-for="Address" class="form-control" placeholder="Địa chỉ cửa hàng" />
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Phone" class="form-label fw-semibold"></label>
                <input asp-for="Phone" class="form-control" placeholder="Số điện thoại liên hệ" />
                <span asp-validation-for="Phone" class="text-danger small"></span>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary flex-grow-1" type="submit">Tạo và sử dụng cửa hàng</button>
                @if (!firstStore) { <a class="btn btn-light-primary" asp-action="Select">Hủy</a> }
            </div>
        </form>
    </div>
</section>
